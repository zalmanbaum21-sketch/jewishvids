# TiDB Cloud Starter / MySQL-compatible database
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/DATABASE?ssl={"rejectUnauthorized":true}

# Cloudflare R2 S3-compatible storage
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=jewish-videos

# Used to sign the site's HTTP-only access-code sessions
JWT_SECRET=replace-with-a-long-random-secret

# Optional Manus compatibility variables; leave blank if you are not using Manus OAuth/AI features
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
